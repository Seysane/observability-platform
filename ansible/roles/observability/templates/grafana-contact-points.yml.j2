---
apiVersion: 1

contactPoints:
  - orgId: 1
    name: discord-alerts
    receivers:
      - uid: discord-webhook
        type: discord
        settings:
          url: {{ discord_webhook_url | to_json }}
          use_discord_username: false
          message: '{{ "{{ template \"default.message\" ." }} }}'

policies:
  - orgId: 1
    receiver: discord-alerts
    group_by:
      - alertname
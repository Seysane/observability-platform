---
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  # Monitor Prometheus itself
  - job_name: prometheus
    static_configs:
      - targets:
          - prometheus:9090

  # Check client application availability over HTTP
  - job_name: client-app
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - "http://{{ client_app_host }}:{{ client_app_port }}/"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
  # Monitor CPU, memory, disk and network on observability VM
  - job_name: observability-node
    static_configs:
      - targets:
          - node-exporter:9100

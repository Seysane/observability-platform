services:
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: dashboard
      POSTGRES_USER: dashboard
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in the .env file}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U dashboard -d dashboard"]
      interval: 5s
      timeout: 3s
      retries: 10
    restart: unless-stopped

  dashboard:
    image: "{{ app_image }}:{{ app_tag }}"
    depends_on:
      db:
        condition: service_healthy
    environment:
      DATABASE_URL: postgresql://dashboard:${POSTGRES_PASSWORD}@db:5432/dashboard
      APP_VERSION: "{{ app_tag }}"
    ports:
      - "8080:8080"
    restart: unless-stopped

volumes:
  pgdata:
